// PostgreSQL schema for cloud deployment (Neon / any Postgres)
// Usage: copy this file to schema.prisma, set DATABASE_URL in .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Article {
  id        Int      @id @default(autoincrement())
  title     String
  summary   String   @default("")
  content   String
  category  String   @default("")
  status    String   @default("draft")
  viewCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GameScore {
  id        Int      @id @default(autoincrement())
  game      String
  score     Int      @default(0)
  createdAt DateTime @default(now())
  @@unique([game])
}

model Todo {
  id        Int      @id @default(autoincrement())
  content   String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Message {
  id        Int      @id @default(autoincrement())
  nickname  String
  content   String
  createdAt DateTime @default(now())
}

model SiteConfig {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model SiteStat {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value Int    @default(0)
}

model Diary {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  date      String   @default("")
  createdAt DateTime @default(now())
}

model User {
  id         Int         @id @default(autoincrement())
  username   String      @unique
  password   String
  nickname   String
  avatar     String      @default("")
  token      String      @unique
  createdAt  DateTime    @default(now())
  scores     UserScore[]
}

model UserScore {
  id        Int      @id @default(autoincrement())
  userId    Int
  game      String
  score     Int      @default(0)
  difficulty String   @default("")
  createdAt DateTime @default(now())
  @@unique([userId, game, difficulty])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
